  "tool_view": {
    "description_suffix": "Use mcp__environment__execute for all AppWorld work; resolve exact schemas, literal output templates, and date or unit boundaries before acting.",
    "error_normalization": false,
    "examples": [
      "Before using an unfamiliar API, read its exact schema. Match parameter names, types, required fields, and response nesting; after a 422 or local error, correct that contract rather than repeating the call.",
      "When a request gives a literal output path or template, decompose each separator and placeholder before writing. Keep independent scopes separate and verify the final path and content before completion.",
      "For date or unit comparisons, derive inclusive boundaries from the current date and compare like units. Do not discard a candidate because a response uses a different unit or boundary convention.",
      "After login, extract the access token from the response and pass only that string to protected calls. If a 401 occurs, verify the app-specific identifier and token before retrying."
    ],
    "helper_tool": false
  }
