# Source this file after replacing paths. Never commit .env.
export POLICY_MODEL=/path/to/Qwen3.5-4B
export POLICY_DIST_CHECKPOINT=/path/to/Qwen3.5-4B_torch_dist
export APPWORLD_ROOT=/path/to/appworld
export APPWORLD_PYTHON=/path/to/appworld-env/bin/python
export NODE_ROOT=/path/to/node-22
# Optional: only for explicitly enabled LLM voting / profile calibration.
export ROUTER_BASE_URL=https://your-provider.example/v1
export ROUTER_MODEL=your-router-model
export ROUTER_API_KEY=
# Optional: export DOCKER_HOST=unix:///var/run/docker.sock
