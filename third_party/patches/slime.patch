+import time
 from typing import Any
 
 from slime.utils.http_utils import get, post
@@ -7,6 +8,9 @@ from slime.utils.http_utils import get, post
 logger = logging.getLogger(__name__)
 
 ABORT_RETRY_INTERVAL_SECONDS = 3
+IDLE_RETRY_INTERVAL_SECONDS = 1
+IDLE_CONFIRMATIONS = 5
+IDLE_TIMEOUT_SECONDS = 300
 
 
 def num_requests_from_load(load: Any) -> int:
@@ -65,3 +69,74 @@ async def abort_server_until_idle(url: str, retry_interval: int = ABORT_RETRY_IN
 
 async def abort_servers_until_idle(urls: list[str]) -> None:
     await asyncio.gather(*(abort_server_until_idle(url) for url in urls))
+
+
+async def wait_server_until_stably_idle(
+    url: str,
+    *,
+    retry_interval: float = IDLE_RETRY_INTERVAL_SECONDS,
+    confirmations: int = IDLE_CONFIRMATIONS,
+    timeout: float = IDLE_TIMEOUT_SECONDS,
+) -> None:
+    """Wait for natural request completion before colocated memory offload.
+
+    Qwen3.5's Mamba request pool can still be completing asynchronous cleanup
+    immediately after ``/v1/loads`` first reports zero. Requiring several
+    consecutive idle observations avoids racing that cleanup. We deliberately
+    do not call ``/abort_request`` here: aborting a live Mamba request while its
+    KV memory is about to be offloaded can itself trigger an illegal CUDA access.
+    """
+
+    if confirmations < 1:
+        raise ValueError("confirmations must be at least 1")
+    deadline = time.monotonic() + timeout
+    idle_observations = 0
+    consecutive_errors = 0
+    while True:
+        if time.monotonic() >= deadline:
+            raise TimeoutError(f"Timed out waiting for SGLang server {url} to become stably idle")
+        try:
+            num_requests = await _get_server_num_requests(url)
+            consecutive_errors = 0
+        except Exception as exc:
+            consecutive_errors += 1
+            logger.warning(
+                "Failed to read SGLang server load from %s (%d/3): %s",
+                url,
+                consecutive_errors,
+                exc,
+            )
+            if consecutive_errors >= 3:
+                raise RuntimeError(f"SGLang server {url} disappeared while waiting for idle") from exc
+            idle_observations = 0
+            await asyncio.sleep(retry_interval)
+            continue
+
+        if num_requests <= 0:
+            idle_observations += 1
+            if idle_observations >= confirmations:
+                logger.info(
+                    "SGLang server %s is stably idle (%d/%d)",
+                    url,
+                    idle_observations,
+                    confirmations,
+                )
+                return
+        else:
+            if idle_observations:
+                logger.info(
+                    "SGLang server %s became busy again after %d idle observations",
+                    url,
+                    idle_observations,
+                )
+            idle_observations = 0
+            logger.info(
+                "Waiting for SGLang server %s to drain naturally: %d requests remain",
+                url,
+                num_requests,
+            )
+        await asyncio.sleep(retry_interval)
+
+
+async def wait_servers_until_stably_idle(urls: list[str]) -> None:
+    await asyncio.gather(*(wait_server_until_stably_idle(url) for url in urls))
