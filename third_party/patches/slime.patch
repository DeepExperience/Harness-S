+def pad_train_data_for_dp_alignment(data: dict[str, Any], sources: list[int]) -> None:
+    """Append zero-loss duplicates selected by :func:`dynamic_dp_padding_sources`.
+
+    Only list-valued per-sample fields are extended.  Token-shaped auxiliary
+    fields (rollout log-probs, top-p replay data, teacher outputs, and so on)
+    are copied from the source so all forward paths remain structurally valid;
+    the all-zero loss mask makes their gradient contribution exactly zero.
